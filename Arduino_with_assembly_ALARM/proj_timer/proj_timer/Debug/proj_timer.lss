                                 ; Check and Load Correct Number Pattern 
                                 check_value:
00029b 3060                      	CPI  R22, 0        																	; Compare digit value with 0
00029c f1b1                      	BREQ detected_0    																	; If equal, go to digit 0 pattern
                                 
00029d 3061                      	CPI R22,1
00029e f081                      	BREQ detected_1
                                 
00029f 3062                      	CPI R22,2
0002a0 f091                      	BREQ detected_2
                                 
0002a1 3063                      	CPI R22,3
0002a2 f0a1                      	BREQ detected_3
                                 
0002a3 3064                      	CPI R22,4
0002a4 f0b1                      	BREQ detected_4
                                 
0002a5 3065                      	CPI R22,5
0002a6 f0c1                      	BREQ detected_5
                                 
0002a7 3066                      	CPI R22,6
