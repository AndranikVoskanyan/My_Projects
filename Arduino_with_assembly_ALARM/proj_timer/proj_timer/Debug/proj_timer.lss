                                 .equ	FIRSTBOOTSTART	= 0x3f00
                                 .equ	SECONDBOOTSTART	= 0x3e00
                                 .equ	THIRDBOOTSTART	= 0x3c00
                                 .equ	FOURTHBOOTSTART	= 0x3800
                                 .equ	SMALLBOOTSTART	= FIRSTBOOTSTART
                                 .equ	LARGEBOOTSTART	= FOURTHBOOTSTART
                                 
                                 
                                 
                                 ; ***** INTERRUPT VECTORS ************************************************
                                 .equ	INT0addr	= 0x0002	; External Interrupt Request 0
                                 .equ	INT1addr	= 0x0004	; External Interrupt Request 1
                                 .equ	PCI0addr	= 0x0006	; Pin Change Interrupt Request 0
                                 .equ	PCI1addr	= 0x0008	; Pin Change Interrupt Request 0
                                 .equ	PCI2addr	= 0x000a	; Pin Change Interrupt Request 1
                                 .equ	WDTaddr	= 0x000c	; Watchdog Time-out Interrupt
                                 .equ	OC2Aaddr	= 0x000e	; Timer/Counter2 Compare Match A
                                 .equ	OC2Baddr	= 0x0010	; Timer/Counter2 Compare Match A
                                 .equ	OVF2addr	= 0x0012	; Timer/Counter2 Overflow
                                 .equ	ICP1addr	= 0x0014	; Timer/Counter1 Capture Event
                                 .equ	OC1Aaddr	= 0x0016	; Timer/Counter1 Compare Match A
                                 .equ	OC1Baddr	= 0x0018	; Timer/Counter1 Compare Match B
                                 .equ	OVF1addr	= 0x001a	; Timer/Counter1 Overflow
                                 .equ	OC0Aaddr	= 0x001c	; TimerCounter0 Compare Match A
                                 .equ	OC0Baddr	= 0x001e	; TimerCounter0 Compare Match B
                                 .equ	OVF0addr	= 0x0020	; Timer/Couner0 Overflow
                                 .equ	SPIaddr	= 0x0022	; SPI Serial Transfer Complete
                                 .equ	URXCaddr	= 0x0024	; USART Rx Complete
                                 .equ	UDREaddr	= 0x0026	; USART, Data Register Empty
                                 .equ	UTXCaddr	= 0x0028	; USART Tx Complete
                                 .equ	ADCCaddr	= 0x002a	; ADC Conversion Complete
                                 .equ	ERDYaddr	= 0x002c	; EEPROM Ready
                                 .equ	ACIaddr	= 0x002e	; Analog Comparator
                                 .equ	TWIaddr	= 0x0030	; Two-wire Serial Interface
                                 .equ	SPMRaddr	= 0x0032	; Store Program Memory Read
                                 
                                 .equ	INT_VECTORS_SIZE	= 52	; size in words
                                 
                                 #endif  /* _M328PDEF_INC_ */
                                 
                                 ; ***** END OF FILE ******************************************************
                                 
                                 ;;;; main_work uses 4 main functional blocks: main_key, write_input, main_over, and buzzer
                                 ;;;; main_key scans the key matrix, determines the pressed key, encodes it, and passes it to write_input
                                 ;;;; write_input generates the first and second number (MM/SS); result is in R20
                                 ;;;; main_over updates the screen using R25 (minutes) and R20 (seconds)
                                 ;;;; buzzer handles sound output
                                 
                                 ;;;;; R26 Codings
                                 ;;;; 71 – New button pressed ? update value
                                 ;;;; 73 – Timer Start
                                 ;;;; 74 – Buzzer active
                                 ;;;; 75 – Add extra 10 seconds
                                 ;;;; 77 – Buzzer delay state
                                 ;;;; 7F – Reset
                                 
                                 ; Structure of key/numbers (n = not used) 
                                 ; 7 8 9   Reset
                                 ; 4 5 6   Extra 10 seconds
                                 ; 1 2 3   n
                                 ; 0 n n n
                                 
                                 ; During timer counting, only Reset key (F) is active.
                                 ; During buzzer state, only Reset (F) and Extra 10 Seconds (E) keys are active.
                                 
                                 
                                 .INCLUDE "m328pdef.inc"																	; Include AVR definitions
                                 
                                 ;***** Created: 2011-02-09 12:03 ******* Source: ATmega328P.xml **********
                                 ;*************************************************************************
                                 ;* A P P L I C A T I O N   N O T E   F O R   T H E   A V R   F A M I L Y
                                 ;* 
                                 ;* Number            : AVR000
                                 ;* File Name         : "m328Pdef.inc"
                                 ;* Title             : Register/Bit Definitions for the ATmega328P
                                 ;* Date              : 2011-02-09
                                 ;* Version           : 2.35
                                 ;* Support E-mail    : avr@atmel.com
                                 ;* Target MCU        : ATmega328P
                                 ;* 
                                 ;* DESCRIPTION
                                 ;* When including this file in the assembly program file, all I/O register 
                                 ;* names and I/O register bit names appearing in the data book can be used.
                                 ;* In addition, the six registers forming the three data pointers X, Y and 
                                 ;* Z have been assigned names XL - ZH. Highest RAM address for Internal 
                                 ;* SRAM is also defined 
                                 ;* 
                                 ;* The Register names are represented by their hexadecimal address.
                                 ;* 
                                 ;* The Register Bit names are represented by their bit number (0-7).
                                 ;* 
                                 ;* Please observe the difference in using the bit names with instructions
                                 ;* such as "sbr"/"cbr" (set/clear bit in register) and "sbrs"/"sbrc"
                                 ;* (skip if bit in register set/cleared). The following example illustrates
                                 ;* this:
                                 ;* 
                                 ;* in    r16,PORTB             ;read PORTB latch
                                 ;* sbr   r16,(1<<PB6)+(1<<PB5) ;set PB6 and PB5 (use masks, not bit#)
                                 ;* out   PORTB,r16             ;output to PORTB
                                 ;* 
                                 ;* in    r16,TIFR              ;read the Timer Interrupt Flag Register
                                 ;* sbrc  r16,TOV0              ;test the overflow flag (use bit#)
                                 ;* rjmp  TOV0_is_set           ;jump if set
                                 ;* ...                         ;otherwise do something else
                                 ;*************************************************************************
                                 
                                 #ifndef _M328PDEF_INC_
                                 #endif  /* _M328PDEF_INC_ */
                                 
                                 ; ***** END OF FILE ******************************************************
                                 origin:																					
                                 .ORG 0x0000																				
000000 c016                      	RJMP init																			; On reset, jump to the 'init' routine
                                 																						
                                 .ORG 0x0016																				
000016 c16b                          RJMP TIMER1_COMPA_ISR																; Interrupt vector for Timer1 Compare Match A
                                 																						
                                 																						
                                 ;  Initialization Code 															
                                 init:																					
000017 94f8                      	CLI																					; Disable global interrupts during setup
                                 
                                 ;  Reset Timer1 counter to 0 													
                                 
000018 e000                          LDI R16, 0x00																		
000019 9300 0085                     STS TCNT1H, R16																		; High byte of Timer1 = 0
00001b 9300 0084                     STS TCNT1L, R16																		; Low byte of Timer1 = 0
                                 																						
                                 ;  Set Timer1 Compare Match value to 15624 									
                                 ; (For 1Hz with 16MHz clock and 1024 prescaler)										
                                 	
00001d e30d                          LDI   r16, HIGH(15624)																
00001e 9300 0089                     STS   OCR1AH, r16																	
000020 e008                          LDI   r16, LOW(15624)																
000021 9300 0088                     STS   OCR1AL, r16																	
                                 																						
                                 ;  Configure Timer1: CTC mode, Prescaler = 1024 								
                                 ; WGM12 = 1 (CTC mode)																
                                 ; CS12 and CS10 = 1 (prescaler 1024)												
                                 
000023 e00d                          LDI R16, (1 << WGM12) | (1 << CS12) | (1 << CS10)									
000024 9300 0081                     STS TCCR1B, R16																		
                                 																						
                                 ;  Clear TCCR1A  																
                                 
000026 e000                          LDI R16, 0x00																		
000027 9300 0080                     STS TCCR1A, R16																		
                                 																						
                                 ;  Enable Timer1 Compare Match A interrupt 									
                                 
000029 e002                          LDI R16, (1 << OCIE1A)																
00002a 9300 006f                     STS TIMSK1, R16																			
                                 																						
                                 ;  Configure multiple output pins and turn them off (display) 				
                                 
00002c 9a25                      	SBI DDRB,5               															; Set PB5 as output										
00002d 982d                      	CBI PORTB,5              															; Set PB5 as low											
00002e 9a23                      	SBI DDRB,3               															; Set PB3 as output										
00002f 982b                      	CBI PORTB,3              															; Set PB3 as low											
000030 9a24                      	SBI DDRB,4               															; Set PB4 as output										
000031 982c                      	CBI PORTB,4              															; Set PB4 as low											
                                 																							
                                 ;  Configure PB0 as input for button with pull-up (switch) 					
                                 
000032 9820                          CBI DDRB, 0          																; Set PB0 as input													
000033 9a28                          SBI PORTB, 0         																; Enable internal pull-up (button connected to GND)			
                                 																							
                                 ;  Configure PB1 as output for buzzer and turn it off 							
                                 
000034 9a21                      	SBI DDRB, 1              															; Set PB1 as output											
000035 9829                      	CBI PORTB, 1             															; Set PB1 low (buzzer off)									
                                 
                                 ;  Configure PB2 as input for joystick with pull-up 
                                 
000036 9822                      	CBI DDRB, 2              															; Set PB2 as input 
000037 9a2a                      	SBI PORTB, 2             															; Enable internal pull-up (active LOW when pressed)
                                 
                                 ;  Configure PC2 as output for led and turn it off 
                                 
000038 9a3a                      	SBI DDRC,2               															; Set PC2 as output 
000039 9a42                      	SBI PORTC,2              															; LED off (assumes active low)
                                 
                                 ; Configure PC3 as output for led and turn it off initially 
                                 
00003a 9a3b                          SBI DDRC, 3         								 								; Set PC3 as output
00003b 9a43                          SBI PORTC, 3         																; LED off (assumes active low)
                                 																						
                                 ; Initialize necessary registers									
00003c e000                      	LDI R16, 0			  																; Clear key buffer
00003d e010                      	LDI R17, 0			  																; Clear key buffer
00003e e020                      	LDI R18, 0		      																; Clear key buffer
00003f e040                      	LDI R20, 0            																; Clear seconds register
000040 e054                      	LDI R21, 4			  																; set miniute second digits state(decrememnting)
000041 e060                      	LDI R22, 0            																; Clear key buffer
000042 e070                      	LDI R23, 0			  																; Clear key buffer
000043 e080                      	LDI R24, 0            																; Clear temporary key value buffer  
000044 e090                      	LDI R25, 0            																; Clear minutes register
000045 e0a0                      	LDI R26, 0            																; Clear key buffer
000046 e0b0                      	LDI R27, 0            																; Clear key buffer
000047 e0c0                      	LDI R28, 0            																; Clear key buffer
000048 e0d0                      	LDI R29, 0            																; Clear key buffer
000049 e0e0                      	LDI R30, 0            																; Clear key buffer
00004a 9478                      	SEI																					
                                 																						
                                 ;Start state machine												
                                 																						
                                 state_machine:																			
00004b d0c8                      	RCALL main_over		   																; show time on display
                                 						   																
00004c 9b1a                      	SBIS PINB,2            																; If joystick is pressed
00004d e050                      			LDI R21, 0     																; Clear input state (remained numbers are 0s)
                                 						   																
00004e 37a3                      	CPI R26, 0x73		   																; if already in counting or buzzing state don't change state back to counting
00004f f41c                      	BRGE already_timer	   																
                                 						   																
000050 3050                      	CPI R21, 0x00		   																;if all digits are wirtten or joystick pressed start timer
000051 f409                      	BRNE already_timer	   																
000052 e7a3                      		LDI R26, 0x73      																;change state extra second before counting
                                 						   																			   																
                                 	already_timer:		   																
000053 d013                      	RCALL main_key		   																; find pressed key R26 = 0xF1 if button pressed
                                 	                       																
000054 37a1                      	CPI R26, 0x71		   																;if button pressed state 
000055 f039                      	BREQ  call_write_input 																;update memory register if 
                                 						   																
000056 37af                      	CPI R26, 0x7F		   																;reset pressed
000057 f061                      	BREQ hard_reset  	   																
                                 						   																
000058 37a7                      	CPI R26, 0x77		   																;buzzer wait state
000059 f389                      		BREQ state_machine 																
                                 						   																
00005a 37a4                      	CPI R26, 0x74		   																;buzzer state
00005b f44c                      	BRGE call_buzzer       																
                                 						   																
00005c cfee                      	rjmp state_machine     																
                                 																						
                                 call_write_input:																		
00005d d094                      	RCALL write_input     																;call min sec decoding function
00005e 3052                      	CPI R21,2			  																;check are we in minutes or in seconds
00005f f010                      	BRLO not_minutes	  																
000060 2b94                      	OR R25,R20			  																;if in minutes update minute register 
000061 e040                      	LDI R20,0			  																; reset seconds register
                                 	not_minutes:          																
000062 e0a0                      	LDI R26,0			  																; reset state
000063 cfe7                      	RJMP state_machine    																
                                 																																											
                                 hard_reset:																																										
000064 cf9b                      	RJMP origin			  																
                                 						  																
                                 call_buzzer:			  																
000065 d10b                      	RCALL buzzer		  																
000066 cfe4                      	RJMP state_machine	  																
                                 
                                 main_key:				  																						  																
000067 e0b0                      	LDI R27, 0            																; Clear counter register
000068 e0c0                      	LDI R28, 0x00         																; Temporary register to store key column info
                                 																						
                                 ; Set all 4 columns (PD0–PD3) HIGH													
                                 
000069 9a58                      	SBI PORTD,0																					
00006a 9a59                      	SBI PORTD,1
00006b 9a5a                      	SBI PORTD,2
00006c 9a5b                      	SBI PORTD,3
                                 
                                 ; Set columns as INPUTs with pull-up (to read column lines)
                                 
00006d 9853                      	CBI DDRD,3
00006e 9852                      	CBI DDRD,2
00006f 9851                      	CBI DDRD,1
000070 9850                      	CBI DDRD,0
                                 
                                 ; Set rows (PD4–PD7) as OUTPUT
                                 
000071 9a57                      	SBI DDRD,7
000072 9a56                      	SBI DDRD,6
000073 9a55                      	SBI DDRD,5
000074 9a54                      	SBI DDRD,4
                                 
                                 ; Set rows LOW (this allows pressed key to pull column LOW)
                                 
000075 985f                      	CBI PORTD,7
000076 985e                      	CBI PORTD,6
000077 985d                      	CBI PORTD,5
000078 985c                      	CBI PORTD,4
000079 0000                      	NOP                   																; Small delay
00007a 0000                      	NOP
                                 
00007b 9b48                      	SBIS PIND,0
00007c c009                      		RJMP col0
00007d 37a3                      	CPI R26, 0x73																		; don't use first second and thirth column keys during timer state 
00007e f584                      	BRGE dont_use_keys
00007f 9b49                      	SBIS PIND,1
000080 c007                      		RJMP col1
000081 9b4a                      	SBIS PIND,2
000082 c007                      		RJMP col2
000083 9b4b                      	SBIS PIND,3
000084 c007                      		RJMP col3
000085 9508                      	RET   																				; No key detected in this column pass
                                 	
                                 ; Assign column-specific bits to R28
                                 
                                 col0:
000086 63c0                      	ORI R28, 0x30         																; Column 0 (rightmost): OR with 0x30
000087 c006                      	RJMP SKIP_COL_CHECK
                                 
                                 col1:
000088 62c0                      	ORI R28, 0x20         																; Column 1
000089 c004                      	RJMP SKIP_COL_CHECK
                                 
                                 col2:
00008a 61c0                      	ORI R28, 0x10         																; Column 2
00008b c002                      	RJMP SKIP_COL_CHECK
                                 
                                 col3:
00008c 60c0                      	ORI R28, 0x00         																; Column 3 (leftmost)
00008d c000                      	RJMP SKIP_COL_CHECK
                                 
                                 ; Continue after column scan 
                                 
                                 SKIP_COL_CHECK:
                                 	; Set rows HIGH again
00008e 9a5f                      	SBI PORTD,7
00008f 9a5e                      	SBI PORTD,6
000090 9a5d                      	SBI PORTD,5
000091 9a5c                      	SBI PORTD,4
                                 
                                 	; Change rows to INPUT (disconnect)
000092 9857                      	CBI DDRD,7
000093 9856                      	CBI DDRD,6
000094 9855                      	CBI DDRD,5
000095 9854                      	CBI DDRD,4
                                 
                                 	; Change columns back to OUTPUT LOW (prepare for next scan)
000096 9a50                      	SBI DDRD,0
000097 9a51                      	SBI DDRD,1
000098 9a52                      	SBI DDRD,2
000099 9a53                      	SBI DDRD,3
                                 
00009a 9858                      	CBI PORTD,0
00009b 9859                      	CBI PORTD,1
00009c 985a                      	CBI PORTD,2
00009d 985b                      	CBI PORTD,3
00009e 0000                      	NOP
00009f 0000                      	NOP
                                 
                                 ; Check each row for key press 
                                 
0000a0 9b4f                      	SBIS PIND,7           																; Top row (first row)
0000a1 c013                      		RJMP lin7
0000a2 9b4e                      	SBIS PIND,6           																; Second row
0000a3 c020                      		RJMP lin6	
0000a4 37a3                      	CPI R26, 0x73		  																;don't use keys bottom first and second rows 
0000a5 f44c                      	BRGE dont_use_keys
0000a6 33c0                      	CPI R28, 0x30		  																; don't use keys D C
0000a7 f031                      	BREQ not_allowed_keys
0000a8 9b4d                      	SBIS PIND,5           																; Third row
0000a9 c029                      		RJMP lin5
0000aa 30c0                      	CPI R28, 0x00		  																; Don't use keys 0 B
0000ab f411                      	BRNE not_allowed_keys
0000ac 9b4c                      	SBIS PIND,4           																; Bottom row
0000ad c032                      		RJMP lin4
                                 
                                 	not_allowed_keys:
0000ae e0c0                      		LDI R28,0
                                 	dont_use_keys:
0000af 9508                      		RET
                                 
                                 	check_reset:	
0000b0 9842                      		CBI PORTC,2		 																; turn on light	
0000b1 e7af                      		LDI R26, 0x7F	 																; reset code
0000b2 994f                      		SBIC PIND,7  
0000b3 9508                      			RET
0000b4 cffb                      		RJMP check_reset
                                 
                                 ; If a key is pressed on row 7 
                                 
                                 lin7:
0000b5 33c0                      	CPI R28, 0x30           															; Check if "F" key (used as reset)
0000b6 f3c9                      	BREQ check_reset        															; If so, go to reset logic
0000b7 3fbf                      	CPI R27, 0xff           															; Wait until delay/counter hits 1
0000b8 f011                      	BREQ do_7
0000b9 95b3                      	INC R27
0000ba cffa                      	RJMP lin7
                                 
                                 do_7:
0000bb 9842                      	CBI PORTC,2           																; Turn off visual LED indicator (feedback)
0000bc 9b4f                      	SBIS PIND,7           																; Wait for key release
0000bd d056                      		RCALL main_over
0000be 9b4f                      	SBIS PIND,7           																; Wait for key release
0000bf cffb                      		RJMP do_7
0000c0 9a42                      	SBI PORTC,2           																; Turn LED on (registered input)
0000c1 60c7                      	ORI R28, 0x07         																; Register value for this key
0000c2 e7a1                      	LDI R26, 0x71																			
0000c3 9508                      	RET
                                 																						; other linx: have same logic
                                 lin6:
0000c4 33c0                      	CPI R28, 0x30
0000c5 f139                      		BREQ extra_10
0000c6 3fbf                      	CPI R27, 0xff
0000c7 f011                      	BREQ do_6
0000c8 95b3                      	INC R27
0000c9 cffa                      	RJMP lin6
                                 do_6:
0000ca 9842                      	CBI PORTC,2
0000cb 9b4e                      	SBIS PIND,6
0000cc d047                      		RCALL main_over
0000cd 9b4e                      	SBIS PIND,6
0000ce cffb                      		RJMP do_6
0000cf 9a42                      	SBI PORTC,2
0000d0 60c4                      	ORI R28, 0x04
0000d1 e7a1                      	LDI R26, 0x71
0000d2 9508                      	RET
                                 
                                 lin5:
0000d3 3fbf                      	CPI R27, 0xff
0000d4 f011                      	BREQ do_5
0000d5 95b3                      	INC R27
0000d6 cffc                      	RJMP lin5
                                 do_5:
0000d7 9842                      	CBI PORTC,2
0000d8 9b4d                      	SBIS PIND,5
0000d9 d03a                      		RCALL main_over
0000da 9b4d                      	SBIS PIND,5
0000db cffb                      		RJMP do_5
0000dc 9a42                      	SBI PORTC,2
0000dd 60c1                      	ORI R28, 0x01
0000de e7a1                      	LDI R26, 0x71
0000df 9508                      	RET
                                 
                                 lin4:
0000e0 3fbf                      	CPI R27, 0xff
0000e1 f011                      	BREQ do_4
0000e2 95b3                      	INC R27
0000e3 cffc                      	RJMP lin4
                                 do_4:
0000e4 9842                      	CBI PORTC,2
0000e5 9b4c                      	SBIS PIND,4
0000e6 d02d                      		RCALL main_over
0000e7 9b4c                      	SBIS PIND,4
0000e8 cffb                      		RJMP do_4
0000e9 9a42                      	SBI PORTC,2
0000ea 60c0                      	ORI R28, 0x00
0000eb e7a1                      	LDI R26, 0x71
0000ec 9508                      	RET
                                 
                                 ; change to extra 10 seconds state
                                 
                                 extra_10:
0000ed 37a4                      	CPI R26, 0x74 																		;check are we in buzzer state if no pass
0000ee f40c                      	BRGE not_usable
0000ef 9508                      		RET
                                 	not_usable:
0000f0 e7a5                      		LDI R26, 0x75	    															; change stateto extra 10
0000f1 9508                      		RET	
                                 
                                 ; Decode value from register R17 into minutes and seconds (R17[7:4] + R17[3:0]) 
                                 
                                 write_input:
0000f2 2f8c                      	MOV R24, R28              															; Copy R17 (raw key input) into R24 for processing
0000f3 7f80                      	ANDI R24, 0xf0            															; Mask upper 4 bits of R24 (high nibble = column info)
0000f4 70cf                      	ANDI R28, 0x0f            															; Mask lower 4 bits of R17 (low nibble = row info)
0000f5 9586                      	LSR R24                   															; Logical shift right (1)
0000f6 9586                      	LSR R24                   															; (2)
0000f7 9586                      	LSR R24                   															; (3)
0000f8 9586                      	LSR R24                   															; (4) — total: move high nibble to low nibble position
0000f9 0f8c                      	ADD R24, R28             															; Add both nibbles to get the final key value (0–15)
                                 
                                 ; Determine which digit is being entered based on R21 
                                 	
0000fa 3054                      	CPI  R21, 4               															; First minute digit (tens place)
0000fb f039                      	BREQ first_number
                                 
0000fc 3051                      	CPI  R21, 1               															; Second second digit (units place)
0000fd f079                      	BREQ second_number
                                 
0000fe 3052                      	CPI  R21, 2               															; First second digit (tens place)
0000ff f019                      	BREQ first_number
                                 
000100 3053                      	CPI  R21, 3               															; Second minute digit (units place)
000101 f059                      	BREQ second_number
                                 
                                 	not_allowd:
000102 9508                      		RET
                                 
                                 ; First minute digit (tens place of minutes) 
                                 
                                 first_number:
000103 2f68                      	MOV R22, R24
000104 5066                      	SUBI R22, 0x06            															; Ensure value is less than 6
000105 f7e0                      	BRSH not_allowd           															; Reject values 6 or more
000106 2f48                      	MOV R20, R24              															; Move value to R20 (seconds)
000107 0f44                      	LSL R20                   															; Shift 4 bits to high nibble
000108 0f44                      	LSL R20
000109 0f44                      	LSL R20
00010a 0f44                      	LSL R20                   															; R20 = R24 × 0x10 (high nibble of seconds)
00010b 955a                      	DEC R21
00010c 9508                      	RET                       															; Update screen
                                 
                                 ;  Second second digit (units place of seconds) 
                                 
                                 second_number:
00010d 2f68                      	MOV R22, R24
00010e 506a                      	SUBI R22, 0x0a            															; Check if value is < 10
00010f f790                      	BRSH not_allowd
000110 708f                      	ANDI R24, 0x0f            															; Mask value
000111 2b48                      	OR R20, R24               															; Add to R20 (seconds low nibble)
000112 955a                      	DEC R21
000113 9508                      	RET            																		; Update screen
                                 
                                 ; Start Screen Printing Part 
                                 
                                 main_over:
000114 e010                      	LDI R17, 0                															; Buffer byte reader for screen pattern
000115 e070                      	LDI R23, 0                															; Display byte counter
000116 e06f                      	LDI R22, 0x0F             															; Mask value for digit extraction
000117 e020                      	LDI R18, 0                															; State machine step counter
                                 
                                 main_screen:
000118 e020                      	LDI R18, 0                															; Reset display state machine
                                 
                                 start:
                                 
                                 ; State machine to draw each part of the display 
                                 	
000119 3020                      	CPI R18, 0
00011a f049                      	BREQ step_0_screen        															; First minute digit
                                 
00011b 3021                      	CPI R18, 1
00011c f079                      	BREQ step_1_screen        															; Second minute digit
                                 
00011d 3022                      	CPI R18, 2
00011e f089                      	BREQ step_2_screen        															; Colon ":"
                                 
00011f 3023                      	CPI R18, 3
000120 f099                      	BREQ step_3_screen        															; First second's digit
                                 
000121 3024                      	CPI R18, 4
000122 f0c9                      	BREQ step_4_screen        															; Second second's digit
000123 9508                      	RET          																		; If nothing matched, restart
                                 
                                 ; Extract first minute digit (high nibble of R25) 
                                 
                                 step_0_screen:
000124 ef60                      	LDI R22, 0xF0
000125 2369                      	AND R22, R25
000126 9566                      	LSR R22
000127 9566                      	LSR R22
000128 9566                      	LSR R22
000129 9566                      	LSR R22                 															; Shift to get actual digit (0–5)
00012a d170                      	RCALL check_value
00012b c014                      	rjmp start_2
                                 
                                 ; Extract second minute digit (low nibble of R25) 
                                 
                                 step_1_screen:
00012c e06f                      	LDI R22, 0x0F
00012d 2369                      	AND R22, R25
00012e d16c                      	RCALL check_value
00012f c010                      	rjmp start_2
                                 
                                 ; Draw the double dot ":" symbol 
                                 
                                 step_2_screen:
000130 e0ea                      	LDI ZL, low(double_dot << 1)
000131 e0f5                      	LDI ZH, high(double_dot << 1)
000132 9523                      	INC R18
000133 c00c                      	RJMP start_2             															; Begin display loop for this symbol
                                 
                                 ; Extract first second digit (high nibble of R20) 
                                 
                                 step_3_screen:
000134 ef60                      	LDI R22, 0xF0
000135 2364                      	AND R22, R20
000136 9566                      	LSR R22
000137 9566                      	LSR R22
000138 9566                      	LSR R22
000139 9566                      	LSR R22
00013a d160                      	RCALL check_value
00013b c004                      	rjmp start_2
                                 
                                 ; Extract second second digit (low nibble of R20) 
                                 
                                 step_4_screen:
00013c e06f                      	LDI R22, 0x0F
00013d 2364                      	AND R22, R20
00013e d15c                      	RCALL check_value
00013f c000                      	rjmp start_2
                                 
                                 ; Start writing character data to the display 
                                 
                                 start_2:
000140 e010                      	LDI R17, 0x00             															; Reset data byte for shifting
000141 e030                      	LDI R19, 0x00             															; Reset column index
000142 2f82                      	mov R24, R18              															; Copy screen step into position register
000143 958a                      	DEC R24                   															; Adjust index since digits start from 0
                                 
                                 take_value:
000144 303b                      	CPI R19, 11               															; Check if all 11 vertical slices are processed
000145 f0d9                      	BREQ push_val
                                 
000146 303a                      	CPI R19, 10               															; If row marker, re-adjust
000147 f009                      	BREQ update_index
000148 c001                      	RJMP dont_update
                                 
                                 update_index:
000149 e084                      	LDI R24, 4                															; Force to index 4 (for colon maybe?)
                                 
                                 dont_update:
00014a 9533                      	INC R19
00014b 3084                      	CPI R24, 4
00014c f019                      	BREQ update_val          															; If in correct position, load next byte
00014d e010                      	LDI R17, 0x00            															; Else blank value
00014e 9583                      	INC R24
00014f c002                      	RJMP update_iter_loop
                                 
                                 update_val:
000150 9115                      	LPM R17, Z+              															; Load one byte from program memory into R17
000151 e080                      	LDI R24, 0               															; Reset position
                                 
                                 update_iter_loop:
000152 e008                      	LDI R16, 8               															; We need to shift out 8 bits for 1 column
000153 c000                      	RJMP loop_col
                                 
                                 ; Shift register routine for sending bits to display 
                                 
                                 loop_col:
000154 950a                      	DEC R16
000155 9488                      	CLC
000156 9517                      	ROR R17                  															; Rotate right to check bit
000157 f038                      	BRCS output_1            															; If bit set, send 1
000158 982b                      	CBI PORTB,3              															; Else, set data pin (PB3) LOW
                                 
                                 bak:
000159 982d                      	CBI PORTB,5              															; Toggle clock LOW
00015a 9a2d                      	SBI PORTB,5              															; Toggle clock HIGH
00015b 982d                      	CBI PORTB,5              															; Toggle clock LOW again
                                 
00015c 3000                      	CPI R16, 0
00015d f331                      	BREQ take_value          															; If all bits sent, get next column
00015e cff5                      	RJMP loop_col
                                 
                                 output_1:
00015f 9a2b                      	SBI PORTB,3              															; Set data pin (PB3) HIGH
000160 cff8                      	RJMP bak
                                 
                                 ; Latch data after 11 columns are sent 
                                 
                                 push_val:
000161 982c                      	CBI PORTB,4              															; Latch LOW
000162 9a2c                      	SBI PORTB,4              															; Latch HIGH
000163 982c                      	CBI PORTB,4              															; Latch LOW
                                 
000164 9115                      	LPM R17, Z+              															; Prepare next value
000165 307a                      	CPI R23, 10              															; Check if 10 characters (digits) sent
000166 f011                      	BREQ reset_r23
000167 9573                      	INC R23
000168 cfd7                      	RJMP start_2
                                 
                                 reset_r23:
000169 e070                      	LDI R23, 0               															; Reset digit counter
00016a 3025                      	CPI R18, 5
00016b f009                      	BREQ go_back_to_key      															; If all 5 elements (2 min, colon, 2 sec) are drawn
00016c cfac                      	RJMP start               															; Go to next element
                                 
                                 go_back_to_key:
00016d 3050                      	CPI R21, 0
00016e f009                      	BREQ go_back_to_start				 												; If we're done with screen update
00016f 9508                      	RET						 															; If still in key mode, go to keypad
                                 go_back_to_start:
000170 cfa8                      	RJMP start               															;BREQ  out of range
                                 
                                 
                                 buzzer:
000171 e0e0                      	LDI R30,0			   																; resset buzzer waiting counter
000172 37a5                      	CPI R26, 0x75		   																; is there extra 10 sec
000173 f051                      		BREQ extra_10_sec  
                                 
                                 	i_wake_up_no_dealy_needed:
                                 
000174 95e3                      		inc R30
000175 34e0                      		CPI R30, 0x40																	; wait 0x40 iter	
000176 f7e9                      		BRNE i_wake_up_no_dealy_needed
000177 9a19                      		SBI PINB, 1             														; toggle buzzer (toggle PB1)
                                 	
000178 34d0                      		CPI R29, 0x40																	;toggle in total 0x40 times
000179 f011                      		BREQ buzzed             														; if 40 times toggled change state to wait after waiting a second change back to buzzer	
00017a 95d3                      		INC R29                 														; Increment   counter
00017b 9508                      		RET																				;jump back update screen check buttons
                                 
                                 	buzzed:
00017c e7a7                      		LDI R26, 0x77		    														;change state to wait
00017d 9508                      		RET 
                                 
                                 ; If top-right key pressed, add a delay before restarting 
                                 
                                 	extra_10_sec:
00017e e140                      		LDI R20, 0x10            														; Set seconds to 0x10 (16) for 2-second wait
00017f e090                      		LDI R25, 0x00            														; Set minutes to 0
000180 e7a3                      		LDI R26, 0x73
000181 9508                      		RET						 														; Go back
                                 
                                 ; Timer1 Compare Match A Interrupt Handler 
                                 
                                 TIMER1_COMPA_ISR: 
                                 	
000182 9918                      	SBIC PINB, 0               															; switch low work / high pouse 
000183 9518                      		RETI   
000184 37a7                      	CPI R26, 0x77			   															; check wait state
000185 f029                      	BREQ update_buzzer
                                 
000186 37a4                      	CPI R26, 0x74			   															; noting needed from interupt during buzzing or extra 10 implementing part
000187 f434                      	BRGE go_back
                                 
000188 37a3                      	CPI R26, 0x73			   															; timer state jump to decrementing logic
000189 f029                      	BREQ start_iter
                                 
00018a 9518                      	RETI
                                 ; Pause functionality 
                                  update_buzzer:																			; change state to buzzer reset buzzer counter
00018b e7a4                      		LDI R26, 0x74																	;change state to buzzer 
00018c e0d0                      		LDI R29,0																		; reset buzzer counter
00018d 9518                      		RETI			
                                 	go_back:
00018e 9518                      		RETI                
                                 ; Decrement seconds 
                                 start_iter:
00018f 3040                      	CPI R20, 0                 															; If seconds already 0...
000190 f049                      	BREQ sec_0                 
                                 
                                 ; Otherwise, just decrement normally
                                 
000191 954a                      	DEC R20
000192 e06f                      	LDI R22, 0x0F              															; Check if lower nibble is 0xF (from 0x10 -> 0x0F)
000193 2364                      	AND R22, R20
000194 306f                      	CPI R22, 0x0F
000195 f009                      	BREQ overflow_sec          															; If overflowed, fix it
000196 9518                      	RETI
                                 
                                 overflow_sec:                  															; Handle BCD-style decrement correction
000197 7f40                      	ANDI R20, 0xF0             															; Clear lower nibble
000198 6049                      	ORI R20, 0x09              															; Set it to 9 (e.g., 0x20 -> 0x29)
000199 9518                      	RETI
                                 
                                 ; Handle seconds underflow: go to minutes 
                                 
                                 sec_0:
00019a 3090                      	CPI R25, 0                 															; If minutes also 0, we're done
00019b f051                      	BREQ min_0                 															; Go to buzzer
                                 
00019c 959a                      	DEC R25                    															; Otherwise, decrement minutes
00019d e549                      	LDI R20, 0x59              															; Reset seconds to 59 (BCD)
00019e e06f                      	LDI R22, 0x0F
00019f 2369                      	AND R22, R25
0001a0 306f                      	CPI R22, 0x0F
0001a1 f009                      	BREQ overflow_min
0001a2 9518                      	RETI
                                 
                                 overflow_min:                 															; BCD fix for minutes too (when lower nibble is F)
0001a3 7f90                      	ANDI R25, 0xF0
0001a4 6099                      	ORI R25, 0x09
0001a5 9518                      	RETI
                                 
                                 ; When both minutes and seconds reach 0: trigger buzzer 
                                 
                                 min_0:
0001a6 e7a4                      	LDI R26, 0x74
0001a7 e0d0                      	LDI R29, 0				   														 	; without reseting R29 at 00:00 after adding extra 10 R29 has some value so first beep will be shorter after extra 10 sec
0001a8 9518                      	RETI                       														 	; Return from interrupt
                                 		
                                 
                                 
                                 
