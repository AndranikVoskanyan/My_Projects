xst -intstyle ise -ifn "/home/ise/Desktop/RISC_V/immediate_generator.xst" -ofn "/home/ise/Desktop/RISC_V/immediate_generator.syr" 
ngdbuild -intstyle ise -dd _ngo -nt timestamp -i -p xc6slx9-tqg144-2 immediate_generator.ngc immediate_generator.ngd  
map -intstyle ise -p xc6slx9-tqg144-2 -w -logic_opt off -ol high -t 1 -xt 0 -register_duplication off -r 4 -global_opt off -mt off -ir off -pr off -lc off -power off -o immediate_generator_map.ncd immediate_generator.ngd immediate_generator.pcf 
par -w -intstyle ise -ol high -mt off immediate_generator_map.ncd immediate_generator.ncd immediate_generator.pcf 
trce -intstyle ise -v 3 -s 2 -n 3 -fastpaths -xml immediate_generator.twx immediate_generator.ncd -o immediate_generator.twr immediate_generator.pcf 
