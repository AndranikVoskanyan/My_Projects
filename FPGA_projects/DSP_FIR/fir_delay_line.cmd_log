xst -intstyle ise -ifn "/home/ise/Desktop/DSP_FIR/fir_delay_line.xst" -ofn "/home/ise/Desktop/DSP_FIR/fir_delay_line.syr" 
ngdbuild -intstyle ise -dd _ngo -nt timestamp -i -p xc6slx9-tqg144-2 fir_delay_line.ngc fir_delay_line.ngd  
map -intstyle ise -p xc6slx9-tqg144-2 -w -logic_opt off -ol high -t 1 -xt 0 -register_duplication off -r 4 -global_opt off -mt off -ir off -pr off -lc off -power off -o fir_delay_line_map.ncd fir_delay_line.ngd fir_delay_line.pcf 
par -w -intstyle ise -ol high -mt off fir_delay_line_map.ncd fir_delay_line.ncd fir_delay_line.pcf 
trce -intstyle ise -v 3 -s 2 -n 3 -fastpaths -xml fir_delay_line.twx fir_delay_line.ncd -o fir_delay_line.twr fir_delay_line.pcf 
