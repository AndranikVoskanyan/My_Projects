xst -intstyle ise -ifn "/home/ise/Desktop/LED_PATTERNS/led_patterns/button_sync.xst" -ofn "/home/ise/Desktop/LED_PATTERNS/led_patterns/button_sync.syr" 
ngdbuild -intstyle ise -dd _ngo -nt timestamp -i -bm edge_detector.bmm -p xc3sd3400a-fg676-4 button_sync.ngc button_sync.ngd  
