xst -intstyle ise -ifn "/home/ise/Desktop/PWM_LIGHT_BRIGHTNES/pwm_control/button_sync.xst" -ofn "/home/ise/Desktop/PWM_LIGHT_BRIGHTNES/pwm_control/button_sync.syr" 
