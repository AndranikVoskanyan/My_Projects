xst -intstyle ise -ifn "/home/ise/Desktop/PWM_LIGHT_BRIGHTNES/pwm_control/edge_detector.xst" -ofn "/home/ise/Desktop/PWM_LIGHT_BRIGHTNES/pwm_control/edge_detector.syr" 
ngdbuild -intstyle ise -dd _ngo -nt timestamp -i -p xc6slx9-tqg144-2 edge_detector.ngc edge_detector.ngd  
map -intstyle ise -p xc6slx9-tqg144-2 -w -logic_opt off -ol high -t 1 -xt 0 -register_duplication off -r 4 -global_opt off -mt off -ir off -pr off -lc off -power off -o edge_detector_map.ncd edge_detector.ngd edge_detector.pcf 
par -w -intstyle ise -ol high -mt off edge_detector_map.ncd edge_detector.ncd edge_detector.pcf 
